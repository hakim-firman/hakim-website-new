---
import { Image } from 'astro:assets';
import logo from '../assets/hakim-logo.png';
import { nav, site } from '../data/site';
import Icon from './Icon.astro';
---

<header
  id="site-nav"
  class="sticky top-0 z-50 border-b border-line bg-paper/85 backdrop-blur-md transition-[box-shadow,background-color] duration-300 data-[stuck=true]:shadow-[0_1px_0_0_#0000000f,0_12px_30px_-24px_#05391f55]"
>
  <div class="rail flex h-16 items-center justify-between gap-6">
    <a href="/" class="group flex items-center gap-2.5" aria-label={`${site.name} — home`}>
      <Image
        src={logo}
        alt=""
        width={24}
        height={24}
        loading="eager"
        class="size-6 rounded-full transition-transform duration-300 group-hover:scale-110"
      />
      <span class="text-[17px] font-bold tracking-[-0.03em]">{site.shortName}</span>
    </a>

    <nav aria-label="Primary" class="hidden md:block">
      <ul class="flex items-center gap-7">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                data-navlink
                class="relative py-2 text-sm font-medium text-ink-2 transition-colors hover:text-ink aria-[current=true]:text-ink after:absolute after:bottom-0 after:left-0 after:h-px after:w-0 after:bg-green after:transition-all after:duration-300 hover:after:w-full aria-[current=true]:after:w-full"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href="/#contact" class="btn btn-primary hidden sm:inline-flex">Hire me</a>
      <button
        type="button"
        id="nav-toggle"
        class="btn btn-ghost px-2.5 md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <Icon name="menu" size={18} class="[[aria-expanded=true]_&]:hidden" />
        <Icon name="close" size={18} class="hidden [[aria-expanded=true]_&]:block" />
      </button>
    </div>
  </div>

  <div id="mobile-menu" hidden class="border-t border-line bg-paper md:hidden">
    <ul class="rail flex flex-col py-2">
      {
        [...nav, { href: '/#contact', label: 'Contact' }].map((item) => (
          <li>
            <a
              href={item.href}
              data-mobile-link
              class="block border-b border-line py-3.5 text-[15px] font-medium text-ink-2 transition-colors hover:text-green-dark last:border-0"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <!-- scroll progress -->
  <div
    id="scroll-progress"
    class="absolute inset-x-0 bottom-0 h-px origin-left scale-x-0 bg-green"
    aria-hidden="true"
  >
  </div>
</header>

<script>
  const header = document.getElementById('site-nav')!;
  const toggle = document.getElementById('nav-toggle')!;
  const menu = document.getElementById('mobile-menu')!;
  const progress = document.getElementById('scroll-progress')!;
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-navlink]')];

  const setMenu = (open: boolean) => {
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    menu.hidden = !open;
  };

  toggle.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
  menu.querySelectorAll('[data-mobile-link]').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setMenu(false));

  let ticking = false;
  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      const y = window.scrollY;
      header.dataset.stuck = String(y > 8);
      const max = document.documentElement.scrollHeight - window.innerHeight;
      progress.style.transform = `scaleX(${max > 0 ? Math.min(y / max, 1) : 0})`;
      ticking = false;
    });
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Scrollspy: nav hrefs are absolute ("/#work") so they work from sub pages —
  // only the hash part addresses a section on this page.
  const hashOf = (a: HTMLAnchorElement) => (a.getAttribute('href') ?? '').split('#')[1] ?? '';
  const sections = links
    .map((l) => (hashOf(l) ? document.getElementById(hashOf(l)) : null))
    .filter(Boolean) as HTMLElement[];

  if (sections.length && 'IntersectionObserver' in window) {
    const spy = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          links.forEach((l) => l.setAttribute('aria-current', String(hashOf(l) === entry.target.id)));
        });
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((s) => spy.observe(s));
  }
</script>

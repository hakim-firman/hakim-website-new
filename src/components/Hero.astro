---
import { Image } from 'astro:assets';
import portrait from '../assets/hakim-portrait.png';
import logo from '../assets/hakim-logo.png';
import { heroStats, site } from '../data/site';
import Icon from './Icon.astro';

// Same diagonal hatch as the .pen photo card (slope 0.5, 248px apart on y).
const hatch = [
  'repeating-linear-gradient(26.57deg, transparent 0 221px, #FFFFFF1A 221px 222px)',
  'repeating-linear-gradient(-26.57deg, transparent 0 221px, #FFFFFF1A 221px 222px)',
].join(',');
---

<section id="top" class="band">
  <div class="rail grid items-center gap-12 py-14 md:py-[70px] lg:grid-cols-[1fr_428px] lg:gap-16">
    <div class="flex flex-col items-start" data-reveal>
      <p
        class="flex items-center gap-2.5 rounded-full bg-paper py-1.5 pr-4 pl-1.5 shadow-chip outline outline-line-2"
      >
        <Image src={logo} alt="" width={28} height={28} loading="eager" class="size-7 rounded-full" />
        <span class="text-[13px] font-semibold tracking-[-0.01em]">{site.name}</span>
        <span class="size-1 rounded-full bg-ink-3" aria-hidden="true"></span>
        <span class="text-[13px] text-ink-2">Full-Stack Developer</span>
      </p>

      <h1
        class="mt-7 text-[clamp(2.25rem,1.2rem+3.6vw,3.5rem)] leading-[1.06] font-semibold tracking-[-0.045em]"
      >
        Web artisan work,<br class="hidden sm:block" /> built clean and shipped fast.
      </h1>

      <p class="mt-5 max-w-[52ch] text-[15px] leading-[1.65] text-ink-2">
        I'm a fullstack developer with over 5 years of experience crafting web products end to end. Solid
        architecture with Laravel and Filament, polished interfaces with React and Livewire.
      </p>

      <div class="mt-7 flex flex-wrap items-center gap-3">
        <a href="/#about" class="btn btn-primary">
          About me
          <Icon name="arrow" size={15} />
        </a>
        <a href="/deck" class="btn btn-ghost">My works</a>
      </div>

      <dl class="mt-9 grid w-full grid-cols-3 border-t border-line">
        {
          heroStats.map((s) => (
            <div class="flex flex-col gap-1 pt-4.5 pr-4">
              <dt class="order-2 text-[13px] text-ink-2">{s.label}</dt>
              <dd class="order-1 font-mono text-[26px] leading-none font-medium tracking-[-0.04em]">
                {s.value}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div
      class="group relative mx-auto w-full max-w-[428px] overflow-hidden rounded-2xl bg-green"
      data-reveal
      style="--reveal-delay:120ms"
    >
      <div class="pointer-events-none absolute inset-0" style={`background-image:${hatch}`} aria-hidden="true">
      </div>

      <Image
        src={portrait}
        alt={`${site.name}, full-stack web developer, smiling in a dark shirt`}
        widths={[332, 664]}
        sizes="(min-width: 1024px) 332px, 70vw"
        loading="eager"
        fetchpriority="high"
        class="relative mx-auto block w-[78%] max-w-[332px] translate-y-1 object-contain transition-transform duration-500 ease-out group-hover:-translate-y-1"
      />

      <p
        class="absolute inset-x-4 bottom-4 flex items-center gap-3 rounded-xl bg-paper/95 p-4 shadow-chip backdrop-blur"
      >
        <span
          class="flex size-[34px] shrink-0 items-center justify-center rounded-[9px] bg-green text-white transition-transform duration-300 group-hover:scale-110"
        >
          <Icon name="check" size={17} />
        </span>
        <span class="flex flex-col gap-0.5">
          <span class="text-[13.5px] font-semibold tracking-[-0.02em]">Open to new work</span>
          <span class="text-[11.5px] text-ink-2">Sleman, ID · GMT+7 · replies in a day</span>
        </span>
      </p>
    </div>
  </div>
</section>

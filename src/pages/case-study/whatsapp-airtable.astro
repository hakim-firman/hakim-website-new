---
import SubPage from '../../layouts/SubPage.astro';
import Icon from '../../components/Icon.astro';
import { caseStudy, project, site } from '../../data/site';

const iconFor = { message: 'message', code: 'code', table: 'table', check: 'check' } as const;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: caseStudy.title,
  about: 'Laravel WhatsApp webhook synced to Airtable',
  abstract: caseStudy.sub,
  creator: { '@id': `${site.url}/#person` },
  url: `${site.url}${caseStudy.slug}`,
  dateCreated: '2025-01',
  keywords: 'Laravel, WhatsApp API, Airtable, webhook, automation',
};
---

<SubPage
  title={`${caseStudy.title} — case study by ${site.name}`}
  description={caseStudy.sub}
  kicker={caseStudy.kicker}
  heading={caseStudy.title}
  sub={caseStudy.sub}
  closing="Got something similar to automate?"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

  <section class="band">
    <div class="rail py-10">
      <dl class="grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          caseStudy.meta.map((m) => (
            <div class="flex flex-col gap-1.5" data-reveal>
              <dt class="font-mono text-[10px] tracking-[0.12em] text-ink-3 uppercase">{m.k}</dt>
              <dd class="text-[14px] font-medium">{m.v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="band">
    <div class="rail py-14">
      <h2 class="text-[22px] font-semibold tracking-[-0.03em]" data-reveal>{caseStudy.flowHeading}</h2>

      <ol
        class="mt-7 flex flex-col gap-2 rounded-2xl bg-ink p-6 text-white sm:flex-row sm:flex-wrap sm:items-center sm:justify-center lg:flex-nowrap"
        data-reveal
      >
        {
          project.flow.map((f, i) => (
            <>
              <li class="group flex flex-1 flex-col items-center gap-3 px-3 py-4 text-center">
                <span class="flex size-11 items-center justify-center rounded-full bg-green/15 text-green transition-transform duration-300 group-hover:scale-110">
                  <Icon name={iconFor[f.icon]} size={18} />
                </span>
                <span class="text-[13.5px] font-semibold">{f.title}</span>
                <span class="font-mono text-[11px] text-white/55">{f.caption}</span>
              </li>
              {i < project.flow.length - 1 && (
                <li class="hidden shrink-0 items-center justify-center text-white/25 sm:flex" aria-hidden="true">
                  <Icon name="arrow" size={16} />
                </li>
              )}
            </>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="band">
    <div class="rail py-14">
      <h2 class="text-[22px] font-semibold tracking-[-0.03em]" data-reveal>{caseStudy.codeHeading}</h2>

      <ul class="mt-6 flex flex-col gap-3">
        {
          project.checks.map((c) => (
            <li class="flex items-start gap-2.5 text-[14px]" data-reveal>
              <Icon name="check" size={15} class="mt-1 shrink-0 text-green" />
              {c}
            </li>
          ))
        }
      </ul>

      <figure class="mt-8 overflow-hidden rounded-2xl bg-ink" data-reveal>
        <figcaption class="flex items-center gap-3 border-b border-white/10 px-5 py-3">
          <span class="flex gap-1.5" aria-hidden="true">
            <span class="size-2.5 rounded-full bg-[#FF5F57]"></span>
            <span class="size-2.5 rounded-full bg-[#FEBC2E]"></span>
            <span class="size-2.5 rounded-full bg-[#28C840]"></span>
          </span>
          <span class="truncate font-mono text-[11px] text-white/50">{caseStudy.codeFile}</span>
        </figcaption>
        <pre
          class="overflow-x-auto p-5 font-mono text-[12.5px] leading-[1.8] text-[#C9EBD9]"><code>{caseStudy.code}</code></pre>
      </figure>
    </div>
  </section>
</SubPage>

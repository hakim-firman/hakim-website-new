---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { deckSlides, site } from '../data/site';

// eager-glob the exported slides so Astro optimises them
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/deck/slide-*.png', { eager: true });
const slides = deckSlides.map((s) => ({
  ...s,
  img: files[`../assets/deck/slide-${String(s.n).padStart(2, '0')}.png`]!.default,
}));

const pdf = '/deck/hakim-firman-portfolio.pdf';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'PresentationDigitalDocument',
  name: `${site.name} — portfolio deck`,
  url: `${site.url}/deck`,
  author: { '@id': `${site.url}/#person` },
  about: 'Laravel and full-stack web development portfolio',
  encoding: { '@type': 'MediaObject', contentUrl: `${site.url}${pdf}`, encodingFormat: 'application/pdf' },
};
---

<Base
  title={`Portfolio deck — ${site.name}`}
  description="Thirteen-slide portfolio deck: what I build, the stack behind it, and seven shipped systems — tracking, payments, real-time dashboards and AI automation."
>
  <header class="band sticky top-0 z-50 bg-paper/90 backdrop-blur-md">
    <div class="rail flex h-[72px] items-center justify-between gap-6">
      <a
        href="/"
        class="group inline-flex items-center gap-2 text-[13.5px] font-medium text-ink-2 transition-colors hover:text-ink"
      >
        <span class="transition-transform duration-300 group-hover:-translate-x-0.5" aria-hidden="true">←</span>
        Back to home
      </a>

      <div class="flex items-center gap-3">
        <span class="hidden font-mono text-[11px] text-ink-3 sm:block">
          <span data-deck-current>1</span>/{slides.length}
        </span>
        <a href={pdf} download class="btn btn-ghost">Download PDF</a>
      </div>
    </div>
  </header>

  <main id="main">
    <section class="band">
      <div class="rail py-10 md:py-12">
        <p class="kicker" data-reveal>— Portfolio deck</p>
        <h1 class="section-title mt-4" data-reveal>Fullstack developer.<br />Systems that keep running.</h1>
        <p class="mt-5 max-w-[62ch] text-[15px] leading-[1.7] text-ink-2" data-reveal>
          I build the parts of a product that cannot fall over — tracking, payments, dashboards, automation.
          Arrow keys or swipe to move.
        </p>
      </div>
    </section>

    <section class="band bg-paper-2" aria-label="Slides">
      <div class="rail py-8 md:py-10">
        <figure
          class="relative overflow-hidden rounded-2xl border border-line-2 bg-ink shadow-lift"
          data-deck
        >
          <div class="relative aspect-[16/9] w-full">
            {
              slides.map((s, i) => (
                <Image
                  src={s.img}
                  alt={`Slide ${s.n}: ${s.title}. ${s.note}.`}
                  widths={[960, 1440, 1920]}
                  sizes="(min-width: 1100px) 1040px, 100vw"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  data-deck-slide={s.n}
                  data-title={s.title}
                  data-note={s.note}
                  hidden={i !== 0}
                  class="absolute inset-0 h-full w-full object-contain"
                />
              ))
            }
          </div>

          <figcaption
            class="flex flex-col gap-3 border-t border-white/10 px-5 py-4 text-white sm:flex-row sm:items-center sm:justify-between sm:px-6"
          >
            <span class="flex flex-col gap-1">
              <span class="text-[14px] font-semibold tracking-[-0.02em]" data-deck-title>
                {slides[0].title}
              </span>
              <span class="font-mono text-[11px] text-white/55" data-deck-note>{slides[0].note}</span>
            </span>

            <span class="flex shrink-0 items-center gap-2">
              <button
                type="button"
                data-deck-prev
                aria-label="Previous slide"
                class="flex size-9 cursor-pointer items-center justify-center rounded-full border border-white/20 text-white transition-colors hover:border-green hover:bg-green disabled:opacity-35 disabled:hover:border-white/20 disabled:hover:bg-transparent"
              >
                <Icon name="arrow" size={15} class="rotate-180" />
              </button>
              <button
                type="button"
                data-deck-next
                aria-label="Next slide"
                class="flex size-9 cursor-pointer items-center justify-center rounded-full border border-white/20 text-white transition-colors hover:border-green hover:bg-green disabled:opacity-35 disabled:hover:border-white/20 disabled:hover:bg-transparent"
              >
                <Icon name="arrow" size={15} />
              </button>
            </span>
          </figcaption>
        </figure>

        <ol class="mt-6 flex flex-wrap gap-2" aria-label="Jump to slide">
          {
            slides.map((s) => (
              <li>
                <button
                  type="button"
                  data-deck-dot={s.n}
                  aria-label={`Slide ${s.n}: ${s.title}`}
                  class="flex h-8 min-w-8 cursor-pointer items-center justify-center rounded-full border border-line-2 px-2.5 font-mono text-[11px] text-ink-2 transition-all duration-200 hover:border-green-line hover:bg-green-tint hover:text-green-dark aria-[current=true]:border-ink aria-[current=true]:bg-ink aria-[current=true]:text-white"
                >
                  {String(s.n).padStart(2, '0')}
                </button>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    {/* the deck as text — readable without images, and indexable */}
    <section class="band">
      <div class="rail py-14 md:py-16">
        <h2 class="text-[22px] font-semibold tracking-[-0.03em]" data-reveal>Every slide, in words</h2>
        <ol class="mt-8 border-t border-line">
          {
            slides.map((s) => (
              <li class="flex flex-col gap-1.5 border-b border-line py-5 sm:flex-row sm:gap-8" data-reveal>
                <span class="font-mono text-[12px] text-ink-3 sm:w-16">{String(s.n).padStart(2, '0')}</span>
                <span class="flex flex-col gap-1">
                  <span class="text-[15.5px] font-semibold tracking-[-0.02em]">{s.title}</span>
                  <span class="text-[13.5px] leading-[1.6] text-ink-2">{s.note}</span>
                </span>
              </li>
            ))
          }
        </ol>

        <div class="mt-9 flex flex-wrap gap-3">
          <a href={site.upwork} target="_blank" rel="noopener noreferrer me" class="btn btn-primary">
            Hire me on Upwork
            <Icon name="arrow-up-right" size={15} />
          </a>
          <a href={pdf} download class="btn btn-ghost">Download the PDF</a>
          <a href="/case-study/whatsapp-airtable" class="btn btn-ghost">Read the case study</a>
        </div>
      </div>
    </section>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
</Base>

<script>
  const deck = document.querySelector<HTMLElement>('[data-deck]');
  if (deck) {
    const slides = [...deck.querySelectorAll<HTMLImageElement>('[data-deck-slide]')];
    const dots = [...document.querySelectorAll<HTMLButtonElement>('[data-deck-dot]')];
    const titleEl = deck.querySelector<HTMLElement>('[data-deck-title]')!;
    const noteEl = deck.querySelector<HTMLElement>('[data-deck-note]')!;
    const counter = document.querySelector<HTMLElement>('[data-deck-current]');
    const prev = deck.querySelector<HTMLButtonElement>('[data-deck-prev]')!;
    const next = deck.querySelector<HTMLButtonElement>('[data-deck-next]')!;

    const meta = slides.map((img) => ({ title: img.dataset.title ?? '', note: img.dataset.note ?? '' }));

    let index = 0;

    const show = (next_: number) => {
      index = Math.max(0, Math.min(slides.length - 1, next_));
      slides.forEach((img, i) => (img.hidden = i !== index));
      dots.forEach((dot, i) => dot.setAttribute('aria-current', String(i === index)));
      titleEl.textContent = meta[index].title;
      noteEl.textContent = meta[index].note;
      if (counter) counter.textContent = String(index + 1);
      prev.disabled = index === 0;
      next.disabled = index === slides.length - 1;
      // keep the neighbour ready so paging never waits on a download
      slides[index + 1]?.removeAttribute('loading');
    };

    prev.addEventListener('click', () => show(index - 1));
    next.addEventListener('click', () => show(index + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => show(i)));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'PageDown') show(index + 1);
      else if (e.key === 'ArrowLeft' || e.key === 'PageUp') show(index - 1);
      else if (e.key === 'Home') show(0);
      else if (e.key === 'End') show(slides.length - 1);
      else return;
      e.preventDefault();
    });

    // swipe on touch
    let startX = 0;
    deck.addEventListener('touchstart', (e) => (startX = e.changedTouches[0].clientX), { passive: true });
    deck.addEventListener(
      'touchend',
      (e) => {
        const dx = e.changedTouches[0].clientX - startX;
        if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
      },
      { passive: true },
    );

    show(0);
  }
</script>

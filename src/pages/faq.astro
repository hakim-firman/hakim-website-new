---
import SubPage from '../layouts/SubPage.astro';
import Icon from '../components/Icon.astro';
import { faqs, site } from '../data/site';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  url: `${site.url}/faq`,
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<SubPage
  title={`FAQ — working with ${site.name}`}
  description="Timezone, pricing model, solo or team, stack, and how fast I can start — the questions clients ask before reaching out."
  kicker="— FAQ"
  heading="Before you reach out"
  sub="Timezone, pricing, and how I work — answered before you ask."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

  <section class="band">
    <div class="rail py-6">
      <div class="border-t border-line" data-faq>
        {
          faqs.map((f, i) => (
            <details name="faq" class="group border-b border-line" open={i === 0}>
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-[15.5px] font-semibold tracking-[-0.02em] transition-colors hover:text-green-dark [&::-webkit-details-marker]:hidden">
                {f.q}
                <span
                  class="flex size-7 shrink-0 items-center justify-center rounded-full border border-line-2 text-ink-3 transition-all duration-300 group-open:rotate-90 group-open:border-green group-open:bg-green group-open:text-white"
                  aria-hidden="true"
                >
                  <Icon name="arrow" size={14} />
                </span>
              </summary>
              <div class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out group-open:grid-rows-[1fr]">
                <p class="overflow-hidden text-[14px] leading-[1.7] text-ink-2">
                  <span class="block pb-5">{f.a}</span>
                </p>
              </div>
            </details>
          ))
        }
      </div>

      <p class="mt-6 text-[13.5px] text-ink-2">
        Still unclear? <a href="/#contact" class="text-green-dark underline underline-offset-2">Send the question over</a> — usually answered within a day.
      </p>
    </div>
  </section>
</SubPage>

<style>
  details[data-closing='true'] > div {
    grid-template-rows: 0fr;
  }
</style>

<script>
  document.querySelectorAll<HTMLDetailsElement>('[data-faq] details').forEach((el) => {
    const summary = el.querySelector('summary')!;
    summary.addEventListener('click', (event) => {
      if (!el.open || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      event.preventDefault();
      el.dataset.closing = 'true';
      setTimeout(() => {
        el.open = false;
        delete el.dataset.closing;
      }, 260);
    });
  });
</script>
